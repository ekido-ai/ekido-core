{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpuchain/gpck_manifest/v1",
  "title": "GpckManifest",
  "description": "Checkpoint manifest. The checkpoint ID is the SHA-256 of this document in canonical JSON, without `signature`. Tensors live in safetensors files only; pickle is never used.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "job_id", "attempt", "fencing_token", "logical_step", "epoch", "immutable_hash", "model", "dataset_fingerprint", "exec", "scaler", "canary", "environment", "files", "parent_manifest_hash", "adaptation_manifest_hash", "created_at", "signer", "signature"],
  "properties": {
    "format": { "enum": ["GPCK/1", "GPCK/2"], "description": "GPCK/2 is GPCK/1 with every file encrypted to the job's age recipient: `sha256` and `bytes` describe the stored (encrypted) blob, and each file also carries `plaintext_sha256`, `plaintext_bytes` and `encryption`." },
    "job_id": { "type": "string", "format": "uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "logical_step": { "type": "integer", "minimum": 0, "description": "Optimizer steps completed. Checkpoints exist only at optimizer-step boundaries." },
    "epoch": { "type": "integer", "minimum": 0 },
    "immutable_hash": { "$ref": "#/$defs/sha256", "description": "Canonical hash of the JobSpec. A resume must match exactly." },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" },
        "base_sha256": { "$ref": "#/$defs/sha256" },
        "tokenizer_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dataset_fingerprint": { "$ref": "#/$defs/sha256" },
    "exec": { "$ref": "exec_config.schema.json" },
    "scaler": {
      "description": "FP16 GradScaler state. null for BF16 and no-autocast runs.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "growth_tracker"],
          "dependentRequired": {
            "growth_factor": ["backoff_factor", "growth_interval"],
            "backoff_factor": ["growth_factor", "growth_interval"],
            "growth_interval": ["growth_factor", "backoff_factor"]
          },
          "properties": {
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "growth_factor": { "type": "number", "exclusiveMinimum": 1 },
            "backoff_factor": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "growth_interval": { "type": "integer", "minimum": 1 },
            "growth_tracker": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loss_fp32"],
      "description": "FP32 eval-mode loss on a fixed batch. Recomputed after restore to catch a broken resume.",
      "properties": { "loss_fp32": { "type": "number", "minimum": 0 } }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "driver", "torch"],
      "description": "Self-reported by the provider. Informational, never used as proof of hardware.",
      "properties": {
        "gpu": { "type": "string" },
        "driver": { "type": "string" },
        "torch": { "type": "string" },
        "cuda": { "type": ["string", "null"] },
        "image_digest": { "type": ["string", "null"] }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trainable.safetensors", "optimizer.safetensors"],
      "properties": {
        "trainable.safetensors": { "$ref": "#/$defs/file" },
        "optimizer.safetensors": { "$ref": "#/$defs/file" }
      }
    },
    "parent_manifest_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "adaptation_manifest_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "created_at": { "type": "string", "format": "date-time" },
    "signer": { "$ref": "#/$defs/address" },
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" }
  },
  "if": { "properties": { "format": { "const": "GPCK/2" } }, "required": ["format"] },
  "then": { "properties": { "files": { "properties": { "trainable.safetensors": { "$ref": "#/$defs/encryptedFile" }, "optimizer.safetensors": { "$ref": "#/$defs/encryptedFile" } } } } },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "plaintext_sha256": { "$ref": "#/$defs/sha256" },
        "plaintext_bytes": { "type": "integer", "minimum": 1 },
        "encryption": { "const": "age-v1" }
      }
    },
    "encryptedFile": {
      "type": "object",
      "required": ["sha256", "bytes", "plaintext_sha256", "plaintext_bytes", "encryption"]
    }
  }
}
